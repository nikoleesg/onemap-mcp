{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onemap-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Caches the OneMap bearer token (valid ~3 days) across requests so most
  // tool calls skip the getToken round trip. No "id" on purpose: wrangler's
  // automatic resource provisioning creates the namespace on the first deploy
  // and keeps the Worker linked to it on later ones, so no account-specific
  // id is committed here.
  "kv_namespaces": [
    {
      "binding": "ONEMAP_TOKEN_CACHE"
    }
  ]
  // Secrets (never set here — see README "Setup"), all required:
  //   ONEMAP_EMAIL, ONEMAP_PASSWORD
}
