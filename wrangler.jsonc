{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onemap-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Caches the OneMap bearer token (valid ~3 days) across requests so most
  // tool calls skip the getToken round trip. Create with:
  //   npx wrangler kv namespace create ONEMAP_TOKEN_CACHE
  // then replace the id below with the one it prints.
  "kv_namespaces": [
    {
      "binding": "ONEMAP_TOKEN_CACHE",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ]
  // Secrets (never set here — see README "Setup"), all required:
  //   ONEMAP_EMAIL, ONEMAP_PASSWORD, MCP_SHARED_SECRET
}
